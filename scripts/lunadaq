#!/usr/bin/env bash
# LunaDAQ process control.
#
# Starting the web app is easy; getting rid of a crashed one is not. A frontend
# or backend that died badly can leave its port bound, and the next start then
# fails with "address already in use" — usually in the middle of a shift, to
# someone who did not start it in the first place.
#
#   lunadaq start     start the frontend in the background (freeing its port
#                     first); it keeps running when the terminal is closed
#   lunadaq run       start the frontend in this terminal instead (tmux, debugging)
#   lunadaq backend   start the backend in this terminal
#   lunadaq stop      stop both, escalating from SIGTERM to SIGKILL
#
# stop and restart refuse while a run is going (stopping the server ends it):
# stop the run first, or add --force. start leaves a running interface alone.
#   lunadaq restart   stop both, start the frontend, and start the backend
#                     again in the folder it was using
#   lunadaq status    show what is holding each port
#   lunadaq logs      follow the frontend's log (Ctrl-C to leave)
#
# Only processes that look like ours are ever killed: an unrelated program on
# port 3000 is reported and left alone.

set -uo pipefail

FRONTEND_PORT="${LUNADAQ_FRONTEND_PORT:-3000}"
BACKEND_PORT="${LUNADAQ_BACKEND_PORT:-5001}"
KILL_TIMEOUT="${LUNADAQ_KILL_TIMEOUT:-10}"   # seconds to wait for a clean exit

LOG_DIR="${LUNADAQ_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/lunadaq}"
FRONTEND_LOG="$LOG_DIR/frontend.log"
START_TIMEOUT="${LUNADAQ_START_TIMEOUT:-60}"   # seconds to wait for the frontend to listen

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
FRONTEND_DIR="$REPO_ROOT/frontend"
SERVER_DIR="$REPO_ROOT/server"

if [ -t 1 ]; then
    BOLD=$'\033[1m'; RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RESET=$'\033[0m'
else
    BOLD=""; RED=""; GREEN=""; YELLOW=""; RESET=""
fi

info() { echo "${BOLD}·${RESET} $*"; }
ok()   { echo "${GREEN}✓${RESET} $*"; }
warn() { echo "${YELLOW}!${RESET} $*"; }
err()  { echo "${RED}✗${RESET} $*" >&2; }

# PIDs LISTENing on a port. Empty (and silent) when the port is free or when
# none of ss, lsof and fuser is installed. ss comes first: on this DAQ PC lsof
# does not list the Next.js server's socket at all, so a running frontend was
# reported as "not running" and never stopped.
port_pids() {
    local port="$1" pids=""
    if command -v ss >/dev/null 2>&1; then
        pids=$(ss -ltnpH "sport = :${port}" 2>/dev/null | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u)
        if [ -n "$pids" ]; then echo "$pids"; return; fi
    fi
    if command -v lsof >/dev/null 2>&1; then
        lsof -ti "tcp:${port}" -sTCP:LISTEN 2>/dev/null
    elif command -v fuser >/dev/null 2>&1; then
        fuser -n tcp "$port" 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$'
    fi
}

cmdline() {
    ps -p "$1" -o command= 2>/dev/null | tr -d '\n'
}

# Is this port holder a LunaDAQ process? The backend is the Python/waitress
# process running main.py; the frontend is Next.js, started from this checkout.
is_ours() {
    local role="$1" cmd="$2"
    case "$role" in
        backend)  [[ "$cmd" == *main.py* || "$cmd" == *waitress* ]] ;;
        frontend) [[ "$cmd" == *next-server* || "$cmd" == *"next start"* \
                     || "$cmd" == *"$FRONTEND_DIR"* \
                     || ( "$cmd" == *node* && "$cmd" == *.next* ) ]] ;;
        *) return 1 ;;
    esac
}

# SIGTERM, wait for the process to actually go, SIGKILL if it will not.
kill_pid() {
    local pid="$1" waited=0
    kill -TERM "$pid" 2>/dev/null || return 0
    while kill -0 "$pid" 2>/dev/null; do
        if [ "$waited" -ge "$KILL_TIMEOUT" ]; then
            warn "PID $pid ignored SIGTERM after ${KILL_TIMEOUT}s — sending SIGKILL"
            kill -KILL "$pid" 2>/dev/null
            sleep 1
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done
    ! kill -0 "$pid" 2>/dev/null
}

# Free one port. Returns non-zero only if something we own refused to die.
stop_port() {
    local role="$1" port="$2" label="$3" failed=0 found=0
    local pids; pids="$(port_pids "$port")"

    [ -z "$pids" ] && { info "$label (port $port): not running"; return 0; }

    local pid cmd
    for pid in $pids; do
        cmd="$(cmdline "$pid")"
        [ -z "$cmd" ] && continue
        found=1
        if is_ours "$role" "$cmd"; then
            info "Stopping $label (PID $pid)…"
            if kill_pid "$pid"; then
                ok "$label stopped"
            else
                err "Could not stop PID $pid — try: kill -9 $pid"
                failed=1
            fi
        else
            warn "Port $port is held by something else (PID $pid: ${cmd:0:60}) — left alone"
            failed=1
        fi
    done

    [ "$found" -eq 0 ] && info "$label (port $port): not running"
    return $failed
}

require_dir() {
    [ -d "$1" ] || { err "Not found: $1 (is this script still inside the WebDAQ checkout?)"; exit 1; }
}

# node and python both come from the luna environment.
activate_env() {
    [ "${CONDA_DEFAULT_ENV:-}" = "luna" ] && return 0
    command -v conda >/dev/null 2>&1 || return 0

    local base prefix
    base="$(conda info --base 2>/dev/null)" || return 0
    # Called from inside an environment, some shells report that environment as
    # the base; the real root is above its envs/ directory.
    case "$base" in */envs/*) base="${base%/envs/*}" ;; esac
    [ -n "$base" ] && [ -f "$base/etc/profile.d/conda.sh" ] || return 0

    # Ask conda where luna actually is instead of assuming envs_dirs.
    prefix="$(conda env list 2>/dev/null | awk '$1 == "luna" { print $NF }' | head -1)"

    # conda's shell functions read unset variables, so nounset has to stand down
    # while they run — with it on, activation fails and the app starts against
    # whatever node happens to be on PATH.
    set +u
    # shellcheck disable=SC1091
    . "$base/etc/profile.d/conda.sh"
    if [ -n "$prefix" ]; then
        conda activate "$prefix" 2>/dev/null
    else
        conda activate luna 2>/dev/null
    fi
    if [ "${CONDA_DEFAULT_ENV:-}" != "luna" ] && [ "${CONDA_PREFIX:-}" != "$prefix" ]; then
        warn "Could not activate the 'luna' environment — using the current one"
    fi
    set -u
}

# Is a run going? Asked of the backend itself; no answer counts as no run.
run_going() {
    local answer
    answer="$(curl -s -m 3 "http://127.0.0.1:${BACKEND_PORT}/experiment/run_active" 2>/dev/null)" || return 1
    [[ "$answer" == *'"running":true'* ]]
}

refuse_during_run() {
    [ "$FORCE" = 1 ] && return 0
    if run_going; then
        err "A run is going: stopping the server would end it. Stop the run first, or add --force."
        exit 1
    fi
}

# Is our frontend already up on its port?
frontend_running() {
    local pid
    for pid in $(port_pids "$FRONTEND_PORT"); do
        is_ours frontend "$(cmdline "$pid")" && return 0
    done
    return 1
}

cmd_status() {
    local role port label pids pid cmd
    for entry in "frontend:$FRONTEND_PORT:Frontend" "backend:$BACKEND_PORT:Backend"; do
        IFS=: read -r role port label <<< "$entry"
        pids="$(port_pids "$port")"
        if [ -z "$pids" ]; then
            echo "  $label (port $port): ${YELLOW}not running${RESET}"
            continue
        fi
        for pid in $pids; do
            cmd="$(cmdline "$pid")"
            if is_ours "$role" "$cmd"; then
                echo "  $label (port $port): ${GREEN}running${RESET} — PID $pid"
            else
                echo "  $label (port $port): ${RED}held by another program${RESET} — PID $pid: ${cmd:0:70}"
            fi
        done
    done
}

cmd_stop() {
    refuse_during_run
    local rc=0
    stop_port frontend "$FRONTEND_PORT" "Frontend" || rc=1
    stop_port backend "$BACKEND_PORT" "Backend" || rc=1
    return $rc
}

prepare_frontend() {
    require_dir "$FRONTEND_DIR"
    # Replacing a running interface takes its DAQ server down too.
    frontend_running && refuse_during_run
    # A leftover instance would only make `npm run start` fail on a bound port.
    stop_port frontend "$FRONTEND_PORT" "Frontend" || {
        err "Port $FRONTEND_PORT is not free — not starting."
        exit 1
    }
    activate_env
}

# In this terminal: it stops when the terminal does (inside tmux, or to watch it).
cmd_run() {
    prepare_frontend
    # Braced: bash 3.2 swallows the following multibyte character into the name.
    info "Starting the frontend on port ${FRONTEND_PORT}…"
    cd "$FRONTEND_DIR" && exec npm run start
}

# In the background, in a session of its own: closing the terminal or the SSH
# connection that started it no longer takes the web interface (and the DAQ
# server it launched) down with it.
cmd_start() {
    # Typed again "to be sure": killing the interface would take the DAQ
    # server, and a run in progress, down with it.
    if [ "${1:-}" != "--replace" ] && frontend_running; then
        ok "The frontend is already running on http://localhost:${FRONTEND_PORT} — left as it is."
        echo "  'lunadaq restart' replaces it (refused while a run is going)."
        return 0
    fi
    prepare_frontend
    mkdir -p "$LOG_DIR"
    info "Starting the frontend on port ${FRONTEND_PORT} in the background…"
    (
        cd "$FRONTEND_DIR" || exit 1
        { echo; echo "── $(date '+%Y-%m-%d %H:%M:%S') lunadaq start ──"; } >> "$FRONTEND_LOG"
        if command -v setsid >/dev/null 2>&1; then
            setsid nohup npm run start >> "$FRONTEND_LOG" 2>&1 < /dev/null &
        else
            nohup npm run start >> "$FRONTEND_LOG" 2>&1 < /dev/null &
        fi
    )
    local waited=0
    until [ -n "$(port_pids "$FRONTEND_PORT")" ]; do
        if [ "$waited" -ge "$START_TIMEOUT" ]; then
            err "The frontend did not come up within ${START_TIMEOUT}s. Its log: $FRONTEND_LOG"
            tail -n 15 "$FRONTEND_LOG" >&2
            return 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
    ok "Frontend running on http://localhost:${FRONTEND_PORT} (log: $FRONTEND_LOG)"
    echo "  It keeps running after this terminal is closed; 'lunadaq stop' stops it."
}

cmd_logs() {
    [ -f "$FRONTEND_LOG" ] || { err "No log yet: $FRONTEND_LOG"; exit 1; }
    exec tail -n 50 -F "$FRONTEND_LOG"
}

# The folder (and test mode) of the running backend, to start it again there.
backend_session() {
    local pid
    pid="$(port_pids "$BACKEND_PORT" | head -1)"
    [ -n "$pid" ] && is_ours backend "$(cmdline "$pid")" || return 1
    local dir test=false
    dir="$(readlink "/proc/$pid/cwd" 2>/dev/null || lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')"
    [ -n "$dir" ] || return 1
    tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -q '^TEST_FLAG=.' && test=true   # any value, as the server reads it
    echo "$dir|$test"
}

# Through the web interface's launcher, as the DAQ Server badge does: same
# environment, log and database handling as a start from the page.
start_backend_in() {
    local dir="$1" test="$2" waited=0 answer
    local mode=""
    [ "$test" = true ] && mode=" (test mode)"
    info "Starting the DAQ server again in ${dir}${mode}…"
    until answer="$(curl -s -m 30 -X POST "http://127.0.0.1:${FRONTEND_PORT}/api/server-control" \
            -H 'Content-Type: application/json' \
            -d "{\"action\":\"start\",\"directory\":\"$dir\",\"testMode\":$test}")" \
          && [[ "$answer" == *'"success":true'* ]]; do
        if [ "$waited" -ge 20 ]; then
            err "The DAQ server did not start: ${answer:-no answer}. Start it from the page."
            return 1
        fi
        sleep 2
        waited=$((waited + 2))
    done
    ok "DAQ server started in $dir"
}

cmd_restart() {
    local session=""
    refuse_during_run
    session="$(backend_session)" || session=""
    cmd_stop || true
    cmd_start --replace || return 1
    if [ -n "$session" ]; then
        start_backend_in "${session%|*}" "${session#*|}"
    else
        echo "  The DAQ server was not running: start it from the page (DAQ Server badge)."
    fi
}

cmd_backend() {
    require_dir "$SERVER_DIR"
    stop_port backend "$BACKEND_PORT" "Backend" || {
        err "Port $BACKEND_PORT is not free — not starting."
        exit 1
    }
    activate_env

    # The backend must run in the luna environment: caendaq (and the CAEN
    # libraries behind it) live there. Started against another interpreter it
    # comes up looking healthy and then fails at the first run, with an error
    # about acquisition rather than about the environment — so refuse instead.
    if ! python -c "import caendaq" >/dev/null 2>&1; then
        err "This interpreter has no 'caendaq' module: $(command -v python || echo 'no python on PATH')"
        err "The backend needs the luna environment. Run 'conda activate luna' first,"
        err "or start the server from the web interface, which does it for you."
        exit 1
    fi

    info "Starting the backend on port ${BACKEND_PORT} ($(python -c 'import sys; print(sys.prefix)'))…"
    cd "$SERVER_DIR" && exec python main.py
}

FORCE=0
for arg in "$@"; do [ "$arg" = "--force" ] && FORCE=1; done

case "${1:-start}" in
    start)   cmd_start ;;
    run)     cmd_run ;;
    backend) cmd_backend ;;
    stop)    cmd_stop ;;
    restart) cmd_restart ;;
    status)  cmd_status ;;
    logs)    cmd_logs ;;
    -h|--help|help)
        # The header comment is the help text; print it up to the first line of code.
        awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "${BASH_SOURCE[0]}"
        ;;
    *)
        err "Unknown command '${1}'"
        echo "Usage: lunadaq [start|run|backend|stop|restart|status|logs]" >&2
        exit 2
        ;;
esac
